# Pick ONE provider. Groq is checked first, then OpenAI.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: override the model (defaults: openai/gpt-oss-120b on Groq, gpt-4o-mini on OpenAI)
CHAT_MODEL=

# Contact details the avatar shares and the "Book a call" button opens.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# The deployed address, used for share previews (e.g. https://allyssa.vercel.app)
NEXT_PUBLIC_SITE_URL=
